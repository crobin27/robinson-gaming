---
/**
 * DealerButton Component
 * 
 * Decorative dealer button component for poker table UI.
 * Can be used as a visual indicator or interactive element.
 */

interface Props {
  label?: string;
  animated?: boolean;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  label = "DEALER",
  animated = false,
  size = "md",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "dealer-button--sm",
  md: "dealer-button--md",
  lg: "dealer-button--lg",
};

const dealerButtonClasses = [
  "dealer-button",
  sizes[size],
  animated && "dealer-button--animated",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={dealerButtonClasses} role="img" aria-label="Dealer button">
  <div class="dealer-button__outer">
    <div class="dealer-button__inner">
      <span class="dealer-button__text">{label}</span>
    </div>
  </div>
</div>

<style>
  @import "../../styles/tokens.css";

  .dealer-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .dealer-button__outer {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-gold-300) 0%, var(--color-gold-600) 100%);
    padding: 3px;
    box-shadow: var(--shadow-chip), var(--shadow-gold-md);
    position: relative;
  }

  .dealer-button__inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-charcoal-800) 0%, var(--color-charcoal-900) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    border: 2px solid var(--color-gold-400);
    position: relative;
  }

  .dealer-button__text {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: 0.45em;
    color: var(--color-gold-300);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-widest);
    text-align: center;
    line-height: 1.2;
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
  }

  /* Sizes */
  .dealer-button--sm {
    width: 3rem;
    height: 3rem;
    font-size: 0.75rem;
  }

  .dealer-button--md {
    width: 4.5rem;
    height: 4.5rem;
    font-size: 1rem;
  }

  .dealer-button--lg {
    width: 6rem;
    height: 6rem;
    font-size: 1.25rem;
  }

  /* Animation */
  .dealer-button--animated .dealer-button__outer {
    animation: dealer-pulse 2s ease-in-out infinite;
  }

  @keyframes dealer-pulse {
    0%, 100% {
      box-shadow: var(--shadow-chip), var(--shadow-gold-md);
      transform: scale(1);
    }
    50% {
      box-shadow: var(--shadow-chip), var(--shadow-gold-lg);
      transform: scale(1.05);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .dealer-button--animated .dealer-button__outer {
      animation: none;
    }
  }
</style>
