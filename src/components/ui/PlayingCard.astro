---
/**
 * PlayingCard Component
 * 
 * A playing card component with casino styling.
 * Supports face cards and number cards with suits.
 */

interface Props {
  suit?: "hearts" | "diamonds" | "clubs" | "spades";
  rank?: string | number;
  face?: "front" | "back";
  backDesign?: "blue" | "red" | "grey";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  suit,
  rank,
  face = rank || suit ? "front" : "back",
  backDesign = "blue",
  size = "md",
  class: className = "",
} = Astro.props;

const suits = {
  hearts: { symbol: "?", color: "red" },
  diamonds: { symbol: "?", color: "red" },
  clubs: { symbol: "?", color: "black" },
  spades: { symbol: "?", color: "black" },
};

const suitData = suit ? suits[suit] : null;
const cardClasses = [
  "playing-card",
  `playing-card--${size}`,
  face === "back" && `playing-card--back-${backDesign}`,
  suitData && `playing-card--${suitData.color}`,
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={cardClasses} role="img" aria-label={face === "back" ? "Playing card back" : `${rank} of ${suit}`}>
  {face === "back" ? (
    <div class="playing-card__back">
      <div class="playing-card__back-pattern"></div>
    </div>
  ) : (
    <div class="playing-card__front">
      <div class="playing-card__corner playing-card__corner--top">
        <span class="playing-card__rank">{rank}</span>
        <span class="playing-card__suit">{suitData?.symbol}</span>
      </div>
      <div class="playing-card__center">
        <span class="playing-card__suit playing-card__suit--large">{suitData?.symbol}</span>
        {rank && rank !== "A" && rank !== "J" && rank !== "Q" && rank !== "K" && (
          <div class="playing-card__pips">
            <!-- Pips pattern would go here based on rank -->
            <slot name="pips" />
          </div>
        )}
      </div>
      <div class="playing-card__corner playing-card__corner--bottom">
        <span class="playing-card__rank">{rank}</span>
        <span class="playing-card__suit">{suitData?.symbol}</span>
      </div>
    </div>
  )}
</div>

<style>
  @import "../../styles/tokens.css";

  .playing-card {
    aspect-ratio: 5 / 7;
    border-radius: var(--radius-lg);
    position: relative;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    background: #ffffff;
    overflow: hidden;
    user-select: none;
  }

  /* Sizes */
  .playing-card--sm {
    width: 3rem;
    font-size: 0.75rem;
  }

  .playing-card--md {
    width: 4.5rem;
    font-size: 1rem;
  }

  .playing-card--lg {
    width: 6rem;
    font-size: 1.25rem;
  }

  /* Front face */
  .playing-card__front {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-2);
    position: relative;
  }

  .playing-card__corner {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }

  .playing-card__corner--top {
    align-self: flex-start;
  }

  .playing-card__corner--bottom {
    align-self: flex-end;
    transform: rotate(180deg);
  }

  .playing-card__rank {
    font-size: 1.2em;
  }

  .playing-card__suit {
    font-size: 1em;
  }

  .playing-card__suit--large {
    font-size: 3em;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.15;
  }

  .playing-card__center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .playing-card__pips {
    display: grid;
    gap: var(--space-1);
  }

  /* Colors */
  .playing-card--red .playing-card__rank,
  .playing-card--red .playing-card__suit {
    color: #dc2626;
  }

  .playing-card--black .playing-card__rank,
  .playing-card--black .playing-card__suit {
    color: #1a1a1a;
  }

  /* Back face */
  .playing-card__back {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .playing-card__back-pattern {
    width: 80%;
    height: 80%;
    border-radius: var(--radius-base);
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(255, 255, 255, 0.1) 10px,
      rgba(255, 255, 255, 0.1) 20px
    );
  }

  .playing-card--back-blue {
    background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
  }

  .playing-card--back-red {
    background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
  }

  .playing-card--back-grey {
    background: linear-gradient(135deg, #4b5563 0%, #374151 100%);
  }

  /* Hover effect */
  @media (hover: hover) and (pointer: fine) {
    .playing-card:hover {
      transform: translateY(-4px) rotate(2deg);
      box-shadow: var(--shadow-xl);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .playing-card {
      transition: none;
    }

    .playing-card:hover {
      transform: none;
    }
  }
</style>
