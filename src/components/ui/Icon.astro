---
/**
 * Icon Component
 * 
 * SVG icon wrapper with consistent sizing and styling.
 * Accepts inline SVG or uses slot for custom SVG content.
 */

interface Props {
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  color?: "currentColor" | "primary" | "secondary";
  ariaLabel?: string;
  ariaHidden?: boolean;
  class?: string;
}

const {
  size = "md",
  color = "currentColor",
  ariaLabel,
  ariaHidden = !ariaLabel,
  class: className = "",
} = Astro.props;

const sizes = {
  xs: "icon--xs",
  sm: "icon--sm",
  md: "icon--md",
  lg: "icon--lg",
  xl: "icon--xl",
};

const colors = {
  currentColor: "icon--color-current",
  primary: "icon--color-primary",
  secondary: "icon--color-secondary",
};

const iconClasses = [
  "icon",
  sizes[size],
  colors[color],
  className,
]
  .filter(Boolean)
  .join(" ");
---

<svg
  class={iconClasses}
  aria-label={ariaLabel}
  aria-hidden={ariaHidden ? "true" : undefined}
  role={ariaHidden ? "presentation" : "img"}
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
>
  <slot />
</svg>

<style>
  @import "../../styles/tokens.css";

  .icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Sizes */
  .icon--xs {
    width: 0.75rem;
    height: 0.75rem;
  }

  .icon--sm {
    width: 1rem;
    height: 1rem;
  }

  .icon--md {
    width: 1.5rem;
    height: 1.5rem;
  }

  .icon--lg {
    width: 2rem;
    height: 2rem;
  }

  .icon--xl {
    width: 3rem;
    height: 3rem;
  }

  /* Colors */
  .icon--color-current {
    color: currentColor;
  }

  .icon--color-primary {
    color: var(--color-gold-300);
  }

  .icon--color-secondary {
    color: var(--color-text-secondary);
  }
</style>
