---
import "../styles/navbar.css";
const navLinks = [
  {
    name: "Home",
    url: "/",
    icon: "/icons/Home.svg",
  },
  {
    name: "Projects",
    url: "/#Projects",
    icon: "/icons/Projects.svg",
  },
  {
    name: "Photography",
    url: "/Photography",
    icon: "/icons/Photography.svg",
  },
  {
    name: "About",
    url: "/About",
    icon: "/icons/About.svg",
  },
];
---

<nav class="navbar" role="navigation" aria-label="Main Navigation">
  <div class="navbar-content">
    <!-- Navigation Links with Icons -->
    <ul class="nav-links" aria-label="Primary Navigation Links">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.url}
              class="nav-link"
              aria-label={`Navigate to ${link.name}`}
            >
              <img
                src={link.icon}
                alt={`${link.name} Icon`}
                class="nav-link-icon"
              />
              <span class="nav-link-text">{link.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<!-- Hamburger Icon for Mobile -->
<button aria-label="Toggle Menu" class="hamburger-icon" id="hamburgerBtn">
  <img src="/icons/hamburger.svg" alt="Menu Icon" />
</button>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const hamburgerBtn = document.getElementById("hamburgerBtn");
    const navbar = document.querySelector(".navbar");

    if (hamburgerBtn && navbar) {
      // Toggle navbar visibility on mobile
      hamburgerBtn.addEventListener("click", () => {
        navbar.classList.toggle("mobile-open");
        
        // Update aria label
        const isOpen = navbar.classList.contains("mobile-open");
        hamburgerBtn.setAttribute(
          "aria-label",
          isOpen ? "Close Menu" : "Open Menu"
        );
      });

      // Close navbar when clicking a link on mobile
      document.querySelectorAll(".nav-link").forEach((link) => {
        link.addEventListener("click", () => {
          if (window.innerWidth <= 768) {
            navbar.classList.remove("mobile-open");
            hamburgerBtn.setAttribute("aria-label", "Open Menu");
          }
        });
      });

      // Close navbar when clicking outside on mobile
      document.addEventListener("click", (e) => {
        if (
          window.innerWidth <= 768 &&
          navbar.classList.contains("mobile-open") &&
          !navbar.contains(e.target as Node) &&
          !hamburgerBtn.contains(e.target as Node)
        ) {
          navbar.classList.remove("mobile-open");
          hamburgerBtn.setAttribute("aria-label", "Open Menu");
        }
      });
    }
  });
</script>
