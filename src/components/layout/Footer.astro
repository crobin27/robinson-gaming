---
const socialLinks = [
  {
    href: "https://github.com/crobin27",
    label: "GitHub",
    external: true,
    path: "M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22",
  },
  {
    href: "https://www.linkedin.com/in/crobinson44/",
    label: "LinkedIn",
    external: true,
    path: "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z",
  },
  {
    href: "mailto:cole@robinsongaming.com",
    label: "Email",
    external: false,
    path: "M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6zM22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7",
  },
  {
    href: "/resume.pdf",
    label: "Resume",
    external: false,
    download: true,
    path: "M12 15V3M6 9l6 6 6-6M3 21h18",
  },
];
---

<footer id="contact" class="mx-auto max-w-5xl px-6 pb-8 pt-16">
  <div class="border-t border-border"></div>

  <div
    class="flex flex-col items-center gap-6 pt-8 md:flex-row md:justify-between md:gap-4"
  >
    <p class="text-sm text-muted-foreground">
      Open to collabs &mdash; <a
        href="mailto:cole@robinsongaming.com"
        class="font-medium text-foreground transition-colors hover:text-primary"
        >say hi</a
      >.
    </p>

    <nav aria-label="Contact links" class="flex items-center gap-1">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            download={link.download ? true : undefined}
            aria-label={link.label}
            title={link.label}
            class="inline-flex h-9 w-9 items-center justify-center rounded-md text-foreground/70 transition-colors hover:bg-muted hover:text-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={link.path} />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>

  <div
    class="mt-6 flex items-center justify-between text-xs text-muted-foreground"
  >
    <p>
      &copy; {new Date().getFullYear()} Robinson Gaming. All rights reserved.
    </p>
    <a href="/privacy-policy" class="transition-colors hover:text-foreground">
      Privacy Policy
    </a>
  </div>
</footer>
