---
import PokerTable from "./PokerTable.astro";
---

<section class="poker-section">
  <div class="container">
    <div class="poker-section-header">
      <h2 class="section-title">Live Poker Demo</h2>
      <p class="section-subtitle">
        Watch an automated Texas Hold'em game in action
      </p>
    </div>
    <PokerTable />
  </div>
</section>

<style>
  .poker-section {
    padding: 3rem 2rem;
    background: linear-gradient(180deg, #0a1628 0%, #1a2838 50%, #0a1628 100%);
    position: relative;
    overflow: hidden;
  }

  .poker-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(141, 198, 63, 0.05) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .container {
    max-width: 1600px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    padding: 0 1rem;
  }

  .poker-section-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #7be65a;
    margin-bottom: 0.4rem;
    letter-spacing: 0.02em;
  }

  .section-subtitle {
    font-size: clamp(0.9rem, 1.8vw, 1.1rem);
    color: #b8e6c9;
    margin: 0;
  }

  @media (max-width: 768px) {
    .poker-section {
      padding: 2rem 1rem;
    }

    .poker-section-header {
      margin-bottom: 1rem;
    }
  }
</style>
