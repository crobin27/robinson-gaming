---
// AboutSection.astro
import "../styles/about-section.css";
---

<section class="about-section">
  <div class="container about-content-wrapper">
    <!-- Left Column: Heading, subheading, two buttons -->
    <div class="about-left">
      <h1>About The Developer</h1>
      <p class="subheading-text"></p>
      <div class="engagement-buttons">
        <a
          href="/About"
          class="engagement-button"
          aria-label="Learn more about the developer"
        >
          <img
            src="images/about-section/learn-more.webp"
            alt="Learn more about Cole Robinson"
          />
        </a>
        <!-- Contact Button with mailto link -->
        <a
          href="mailto:cole@robinsongaming.com?subject=Job%20Opportunity&body=Hello%20Cole%2C%0D%0A%0D%0AI%27d%20like%20to%20discuss%20an%20opportunity%20with%20you."
          class="engagement-button"
          aria-label="Contact Cole Robinson"
        >
          <img
            src="images/about-section/contact.webp"
            alt="Contact Cole Robinson"
          />
        </a>
        <!-- LinkedIn Button with LinkedIn link -->
        <a
          href="https://www.linkedin.com/in/crobinson44/"
          target="_blank"
          class="engagement-button"
          aria-label="Visit Cole Robinson's LinkedIn profile"
        >
          <img
            src="images/about-section/linked-in.webp"
            alt="LinkedIn Logo for Cole Robinson's LinkedIn"
          />
        </a>
      </div>
    </div>
    <div class="about-right">
      <img
        src="images/about-section/graduation.webp"
        alt="Cole Robinson celebrating graduation with diploma in hand"
      />
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const aboutSection = document.querySelector(".about-section");
    
    if (!aboutSection) return;

    const observerOptions = {
      threshold: 0.1, // Trigger when 10% of the section is in view
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          aboutSection.classList.add("visible"); // Add the "visible" class to trigger animation
          observer.unobserve(entry.target); // Stop observing after animation starts
        }
      });
    }, observerOptions);

    observer.observe(aboutSection);
  });
</script>
