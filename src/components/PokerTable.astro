---
import PokerTableClient from './PokerTableClient';
---

<div class="poker-table-wrapper">
  <PokerTableClient client:visible />
</div>

<style>
  :global(body) {
    font-family: 'Play', 'Segoe UI', sans-serif;
    background: radial-gradient(circle at top, #0b1d2d 0%, #050b13 60%, #010203 100%);
    color: #f8f9fa;
  }

  .poker-table-wrapper {
    display: flex;
    justify-content: center;
    padding: 2rem;
  }

  .poker-table-container {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    gap: 1.5rem;
    width: min(1200px, 100%);
    backdrop-filter: blur(6px);
    background: rgba(5, 12, 24, 0.68);
    border-radius: 1.5rem;
    border: 1px solid rgba(141, 198, 63, 0.4);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    padding: 1.5rem;
  }

  .table-header {
    grid-column: 1 / -1;
    text-align: center;
  }

  .table-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7be65a;
    margin-bottom: 0.25rem;
  }

  .table-header .stage-indicator {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: #d0e7ff;
  }

  .pot-display {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    background: linear-gradient(120deg, rgba(255, 215, 0, 0.16), rgba(141, 198, 63, 0.25));
    color: #ffe680;
    font-weight: 600;
    box-shadow: inset 0 0 10px rgba(255, 215, 0, 0.25);
  }

  .table-surface {
    position: relative;
    width: 100%;
  }

  .felt-texture {
    position: relative;
    background: radial-gradient(circle at 30% 30%, rgba(15, 60, 32, 0.9), rgba(6, 37, 20, 0.98));
    border-radius: 40% / 25%;
    padding: 3.5rem 2rem 4rem;
    box-shadow: inset 0 30px 50px rgba(0, 0, 0, 0.55);
    border: 12px solid rgba(120, 67, 21, 0.8);
  }

  .table-rail {
    position: absolute;
    inset: 1.25rem;
    border-radius: 40% / 25%;
    border: 10px solid rgba(52, 29, 9, 0.88);
    box-shadow: inset 0 15px 25px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  .community-cards {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .card-slot {
    width: clamp(3.5rem, 6vw, 4.5rem);
    height: clamp(5rem, 8vw, 6rem);
    border-radius: 0.75rem;
    border: 2px solid rgba(255, 255, 255, 0.2);
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.1);
    font-size: 1.4rem;
    color: #f5f5f5;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .card-slot.revealed {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(247, 247, 247, 0.85));
    color: #1c2333;
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.35);
    transform: translateY(-6px) rotate(-2deg);
  }

  .player-ring {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .player {
    background: rgba(0, 12, 10, 0.45);
    border: 1px solid rgba(123, 230, 90, 0.35);
    border-radius: 1rem;
    padding: 1rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .player::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(123, 230, 90, 0.2), rgba(9, 173, 128, 0.08));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .player:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .player:hover::before {
    opacity: 1;
  }

  .player h3 {
    margin: 0;
    font-size: 1.1rem;
    color: #e9f7d9;
  }

  .player-hand {
    display: flex;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }

  .bet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    color: #d1ffd6;
  }

  .bet-list li {
    margin-bottom: 0.25rem;
  }

  .player.winner {
    border-color: rgba(255, 215, 0, 0.8);
    box-shadow: 0 0 25px rgba(255, 215, 0, 0.35);
  }

  .player.winner::before {
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.25), rgba(255, 120, 0, 0.08));
    opacity: 1;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(1, 22, 18, 0.6);
    border-radius: 1.25rem;
    border: 1px solid rgba(141, 198, 63, 0.2);
    box-shadow: inset 0 0 25px rgba(0, 0, 0, 0.4);
  }

  .asset-callout h4,
  .log h4 {
    margin: 0 0 0.5rem;
    color: #7be65a;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.95rem;
  }

  .asset-callout ul,
  .log ol {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.9rem;
    color: #f2fffa;
  }

  .log {
    max-height: 18rem;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .restart {
    margin-top: auto;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    font-weight: 600;
    background: linear-gradient(135deg, rgba(141, 198, 63, 0.8), rgba(17, 128, 96, 0.9));
    color: #03110a;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .restart:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 1024px) {
    .poker-table-container {
      grid-template-columns: 1fr;
    }

    .sidebar {
      order: -1;
    }

    .player-ring {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }

  @media (max-width: 640px) {
    .poker-table-wrapper {
      padding: 1rem;
    }

    .felt-texture {
      padding: 2.5rem 1rem 3rem;
    }

    .community-cards {
      gap: 0.5rem;
    }

    .sidebar {
      padding: 1rem;
    }
  }
</style>
