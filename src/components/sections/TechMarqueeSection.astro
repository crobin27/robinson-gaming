---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import { techRow1, techRow2, type TechItem } from "@/data/tech";

// Fixed item width + gap let us compute an exact pixel shift for a
// pixel-perfect seamless loop. The previous -50% - gap/2 math was
// correct on paper but browsers sometimes rounded it and produced a
// visible jump at the loop boundary.
const ITEM_WIDTH_PX = 72; // 4.5rem
const GAP_PX = 56; // 3.5rem
const SPEED_PX_PER_SEC = 18;

function shiftPx(count: number): number {
  // One full copy of the row (items + their trailing gaps) = exactly
  // the distance the track should translate each loop.
  return count * (ITEM_WIDTH_PX + GAP_PX);
}

function rowDuration(count: number): number {
  return Math.round((shiftPx(count) / SPEED_PX_PER_SEC) * 100) / 100;
}

const row1 = [...techRow1, ...techRow1];
const row2 = [...techRow2, ...techRow2];

const row1Shift = shiftPx(techRow1.length);
const row2Shift = shiftPx(techRow2.length);
const row1Duration = rowDuration(techRow1.length);
const row2Duration = rowDuration(techRow2.length);
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-20 md:py-32">
  <div data-reveal class="mb-12 text-center md:text-left">
    <SectionHeading
      title="Tech I build with"
      subtitle="The tools, languages, and platforms I reach for when shipping software and running infrastructure."
    />
  </div>

  <div data-reveal data-reveal-delay="1" class="marquee-wrapper space-y-2">
    <div class="marquee-row">
      <div
        class="marquee-track"
        style={`animation-duration: ${row1Duration}s; --shift: ${row1Shift}px;`}
      >
        {
          row1.map((tech: TechItem) => {
            return tech.src === null ? (
              <div class="marquee-item" aria-label={tech.name}>
                <div class="missing-tile">{tech.name}</div>
                <span class="marquee-label">{tech.name}</span>
              </div>
            ) : (
              <div
                class:list={["marquee-item", { "tint-dark": tech.tintDark }]}
                style={
                  tech.sizeBoost
                    ? `--size-boost: ${tech.sizeBoost};`
                    : undefined
                }
                aria-label={tech.name}
              >
                {tech.srcDark ? (
                  <>
                    <img
                      src={tech.src}
                      alt={tech.name}
                      loading="lazy"
                      decoding="async"
                      width="48"
                      height="48"
                      class="block dark:hidden"
                    />
                    <img
                      src={tech.srcDark}
                      alt={tech.name}
                      loading="lazy"
                      decoding="async"
                      width="48"
                      height="48"
                      class="hidden dark:block"
                    />
                  </>
                ) : (
                  <img
                    src={tech.src}
                    alt={tech.name}
                    loading="lazy"
                    decoding="async"
                    width="48"
                    height="48"
                  />
                )}
                <span class="marquee-label">{tech.name}</span>
              </div>
            );
          })
        }
      </div>
    </div>

    <div class="marquee-row">
      <div
        class="marquee-track marquee-track-reverse"
        style={`animation-duration: ${row2Duration}s; --shift: ${row2Shift}px;`}
      >
        {
          row2.map((tech: TechItem) => {
            return tech.src === null ? (
              <div class="marquee-item" aria-label={tech.name}>
                <div class="missing-tile">{tech.name}</div>
                <span class="marquee-label">{tech.name}</span>
              </div>
            ) : (
              <div
                class:list={["marquee-item", { "tint-dark": tech.tintDark }]}
                style={
                  tech.sizeBoost
                    ? `--size-boost: ${tech.sizeBoost};`
                    : undefined
                }
                aria-label={tech.name}
              >
                {tech.srcDark ? (
                  <>
                    <img
                      src={tech.src}
                      alt={tech.name}
                      loading="lazy"
                      decoding="async"
                      width="48"
                      height="48"
                      class="block dark:hidden"
                    />
                    <img
                      src={tech.srcDark}
                      alt={tech.name}
                      loading="lazy"
                      decoding="async"
                      width="48"
                      height="48"
                      class="hidden dark:block"
                    />
                  </>
                ) : (
                  <img
                    src={tech.src}
                    alt={tech.name}
                    loading="lazy"
                    decoding="async"
                    width="48"
                    height="48"
                  />
                )}
                <span class="marquee-label">{tech.name}</span>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-wrapper {
    --marquee-gap: 3.5rem;
    position: relative;
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 4%,
      #000 96%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 4%,
      #000 96%,
      transparent 100%
    );
  }

  .marquee-row {
    overflow-x: clip;
    overflow-y: visible;
    padding-block: 1.5rem;
  }

  .marquee-row:last-child {
    padding-bottom: 2.5rem;
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    width: max-content;
    animation-name: marquee-scroll;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  .marquee-track-reverse {
    animation-direction: reverse;
  }

  /* Hover pause intentionally removed — icons should keep scrolling. */

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--shift)));
    }
  }

  .marquee-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 4.5rem;
    cursor: default;
  }

  .marquee-item img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    filter: none;
    opacity: 0.92;
    transform: scale(var(--size-boost, 1));
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      filter 0.25s ease;
  }

  .marquee-item:hover img {
    opacity: 1;
    transform: translateY(-4px) scale(calc(var(--size-boost, 1) * 1.1));
  }

  /* Hover tooltip — absolutely positioned so it doesn't disturb the
     fixed-width flex layout that makes the seamless loop work. */
  .marquee-label {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    translate: -50% -2px;
    padding: 4px 9px;
    border-radius: 6px;
    background: color-mix(
      in oklab,
      var(--background) 80%,
      var(--foreground) 20%
    );
    border: 1px solid var(--border);
    color: var(--foreground);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease;
    z-index: 20;
  }

  .marquee-item:hover .marquee-label {
    opacity: 1;
    translate: -50% 0;
  }

  /* Missing-icon placeholder — bright, obviously different so missing
     entries are easy to spot and replace. */
  .missing-tile {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    border: 1.5px dashed var(--primary);
    border-radius: 0.5rem;
    color: var(--primary);
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    background: color-mix(in oklab, var(--primary) 8%, transparent);
  }

  .marquee-item:hover .missing-tile {
    transform: translateY(-4px) scale(1.08);
    background: color-mix(in oklab, var(--primary) 18%, transparent);
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
