---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import { Badge } from "@/components/ui/badge";

const skillGroups = [
  {
    label: "Cloud & DevOps",
    skills: [
      "AWS",
      "EC2",
      "S3",
      "Lambda",
      "IAM",
      "VPC",
      "CloudFormation",
      "Terraform",
      "Docker",
      "CI/CD",
      "Linux",
    ],
  },
  {
    label: "Software Engineering",
    skills: [
      "React",
      "Astro",
      "TypeScript",
      "Node.js",
      "Python",
      "Git",
      "REST APIs",
      "Tailwind CSS",
    ],
  },
  {
    label: "Other",
    skills: ["Raspberry Pi", "MQTT", "Embedded C", "Photography"],
  },
];
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-20 md:py-32">
  <div data-reveal>
    <SectionHeading
      title="Tech Stack"
      subtitle="What I reach for when building systems, apps, and infrastructure."
    />
  </div>

  <div class="grid gap-10 md:grid-cols-3">
    {
      skillGroups.map((group, i) => (
        <div data-reveal data-reveal-delay={String(i + 1)}>
          <p class="mb-4 text-xs font-medium uppercase tracking-widest text-muted-foreground">
            {group.label}
          </p>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <Badge variant="secondary">{skill}</Badge>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
