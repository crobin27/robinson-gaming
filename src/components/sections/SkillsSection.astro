---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import { Badge } from "@/components/ui/badge";

const skillGroups = [
  {
    label: "Game Development",
    skills: [
      "Unity",
      "C#",
      "iOS",
      "Android",
      "AdMob",
      "ironSource",
      "Unity Ads",
      "App Store Connect",
      "Google Play Console",
    ],
  },
  {
    label: "Software Engineering",
    skills: [
      "React",
      "Astro",
      "TypeScript",
      "Node.js",
      "Git",
      "REST APIs",
      "Tailwind CSS",
    ],
  },
  {
    label: "Other",
    skills: ["Raspberry Pi", "Python", "MQTT", "Embedded C", "Photography"],
  },
];
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-20 md:py-32">
  <SectionHeading
    title="Tech Stack"
    subtitle="What I reach for when building games, apps, and experiments."
  />

  <div class="grid gap-10 md:grid-cols-3">
    {
      skillGroups.map((group) => (
        <div>
          <p class="mb-4 text-xs font-medium uppercase tracking-widest text-muted-foreground">
            {group.label}
          </p>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <Badge variant="secondary">{skill}</Badge>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
