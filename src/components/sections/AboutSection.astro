---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import { photos } from "@/data/photos";
import { cldForVariant, cldLqip } from "@/lib/cloudinary";

const featuredPhotos = photos.filter((p) => p.featured).slice(0, 4);
const photoSlotSeconds = 5;
const photoCycleSeconds = featuredPhotos.length * photoSlotSeconds;

const currentlyItems = [
  "Running IT at a construction firm",
  "Shipping Nest.js + Next.js apps on AWS",
  "Automating ETL with Python, Postgres, and OpenAI",
];

const outsideWork = [
  { label: "Photography", icon: "camera" },
  { label: "Travel", icon: "plane" },
  { label: "Coffee", icon: "coffee" },
  { label: "Reading", icon: "book" },
];

const iconifyLogos = (slug: string) =>
  `https://api.iconify.design/logos:${slug}.svg`;

const stackIcons = [
  { name: "AWS", src: iconifyLogos("aws") },
  { name: "TypeScript", src: iconifyLogos("typescript") },
  { name: "Next.js", src: iconifyLogos("nextjs-icon") },
  { name: "Nest.js", src: iconifyLogos("nestjs") },
  { name: "React", src: iconifyLogos("react") },
  { name: "Python", src: iconifyLogos("python") },
];
---

<section id="about" class="mx-auto max-w-5xl px-6 py-20 md:py-32">
  <div data-reveal class="mb-12">
    <SectionHeading
      title="About me"
      subtitle="A snapshot of who I am, what I'm working on, and what fills the rest of my days."
    />
  </div>

  <div class="bento-grid">
    <!-- Big intro card (2x2) -->
    <article
      class="bento-card bento-intro md:col-span-2 md:row-span-2"
      data-reveal
      data-reveal-delay="1"
    >
      <div class="flex h-full flex-col justify-between gap-6">
        <div>
          <p
            class="mb-3 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-muted-foreground"
          >
            Hey there
          </p>
          <h3
            class="text-3xl font-bold leading-tight tracking-tight md:text-4xl"
          >
            I'm Cole — I build <span class="text-primary"
              >software and the systems it runs on.</span
            >
          </h3>
        </div>
        <div class="space-y-4 text-sm text-muted-foreground md:text-base">
          <p>
            IT manager at a construction contracting firm by trade — which in
            practice means writing software that replaces spreadsheets,
            automating the tedious parts of running the business, and keeping
            the infrastructure behind it humming along.
          </p>
          <p>
            I ship two production web apps our teams, clients, and vendors rely
            on every day: a tenant-locked internal platform (Nest.js + React,
            OpenAI-powered analytics, integrated with Raken, Procore, and Google
            Maps) and an external bid-submission portal for subcontractors and
            vendors (Next.js + Prisma). Both run on AWS with Postgres on RDS,
            Docker, and full CI/CD.
          </p>
          <p>
            The rest of my day is automation — Microsoft Graph API for email
            workflows, Python for Excel and ETL, and Postgres as the glue that
            pulls everything into one source of truth.
          </p>
        </div>
      </div>
    </article>

    <!-- Currently card -->
    <article class="bento-card" data-reveal data-reveal-delay="2">
      <p
        class="mb-4 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-muted-foreground"
      >
        Currently
      </p>
      <ul class="space-y-3 text-sm">
        {
          currentlyItems.map((item) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-primary" />
              <span class="text-foreground/85">{item}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- Location card -->
    <article class="bento-card" data-reveal data-reveal-delay="3">
      <p
        class="mb-3 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-muted-foreground"
      >
        Based in
      </p>
      <div class="flex items-start gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mt-0.5 shrink-0 text-primary"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <div>
          <p class="text-lg font-semibold leading-tight">United States</p>
          <p class="text-xs text-muted-foreground">Remote-friendly</p>
        </div>
      </div>
    </article>

    <!-- Photo card — crossfades through featured photos -->
    {
      featuredPhotos.length > 0 && (
        <a
          href="/photography"
          class="bento-card bento-photo group relative overflow-hidden p-0"
          data-reveal
          data-reveal-delay="4"
          style={`--bento-photo-cycle: ${photoCycleSeconds}s; --bento-photo-slot: ${photoSlotSeconds}s; background-image: url(${cldLqip(featuredPhotos[0].publicId)});`}
        >
          {featuredPhotos.map((photo, i) => (
            <div
              class="bento-photo-slide"
              style={`--i: ${i}; background-image: url(${cldLqip(photo.publicId)});`}
            >
              <img
                src={cldForVariant(photo.publicId, "native", 800)}
                alt={photo.title ?? "Photograph by Cole Robinson"}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
          <div class="absolute inset-0 z-[1] bg-gradient-to-t from-black/80 via-black/10 to-transparent" />
          <div class="relative z-[2] flex h-full flex-col justify-end p-5">
            <p class="text-[0.65rem] font-medium uppercase tracking-[0.18em] text-white/75">
              From the camera
            </p>
            <p class="mt-1 text-sm font-semibold text-white">
              View the gallery →
            </p>
          </div>
        </a>
      )
    }

    <!-- Stack card -->
    <article class="bento-card" data-reveal data-reveal-delay="5">
      <p
        class="mb-4 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-muted-foreground"
      >
        Go-to stack
      </p>
      <div class="grid grid-cols-3 gap-3">
        {
          stackIcons.map((icon) => (
            <div class="stack-icon" title={icon.name}>
              <img
                src={icon.src}
                alt={icon.name}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </article>

    <!-- Outside work card -->
    <article class="bento-card" data-reveal data-reveal-delay="5">
      <p
        class="mb-4 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-muted-foreground"
      >
        When I'm offline
      </p>
      <ul class="grid grid-cols-2 gap-3 text-xs">
        {
          outsideWork.map((item) => (
            <li class="flex items-center gap-2 text-foreground/80">
              {item.icon === "camera" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z" />
                  <circle cx="12" cy="13" r="3" />
                </svg>
              )}
              {item.icon === "plane" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
                </svg>
              )}
              {item.icon === "coffee" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 2v2" />
                  <path d="M14 2v2" />
                  <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1" />
                  <path d="M6 2v2" />
                </svg>
              )}
              {item.icon === "book" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                </svg>
              )}
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(170px, auto);
      gap: 1.25rem;
    }
  }

  .bento-card {
    position: relative;
    padding: 1.5rem;
    border-radius: 1rem;
    background: color-mix(in oklab, var(--card) 100%, transparent);
    border: 1px solid var(--border);
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .bento-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
    box-shadow: 0 14px 40px -20px rgba(0, 0, 0, 0.5);
  }

  .bento-intro {
    background:
      radial-gradient(
        circle at 0% 0%,
        color-mix(in oklab, var(--primary) 12%, transparent),
        transparent 60%
      ),
      var(--card);
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .bento-intro {
      padding: 2.5rem;
    }
  }

  .bento-photo {
    min-height: 220px;
    background-size: cover;
    background-position: center;
  }

  .bento-photo-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-size: cover;
    background-position: center;
    animation-name: bento-photo-cycle;
    animation-duration: var(--bento-photo-cycle, 20s);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-delay: calc(var(--i) * var(--bento-photo-slot, 5s));
    will-change: opacity, transform;
  }

  .bento-photo-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }

  .bento-photo:hover .bento-photo-slide img {
    transform: scale(1.05);
  }

  @keyframes bento-photo-cycle {
    0% {
      opacity: 0;
      transform: scale(1.03);
    }
    5% {
      opacity: 1;
    }
    25% {
      opacity: 1;
      transform: scale(1.09);
    }
    30% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-photo-slide {
      animation: none;
    }
    .bento-photo-slide:first-child {
      opacity: 1;
    }
  }

  .stack-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--muted) 60%, transparent);
    border: 1px solid var(--border);
    transition:
      transform 0.3s ease,
      background-color 0.3s ease;
  }

  .stack-icon:hover {
    transform: translateY(-2px) scale(1.04);
    background: color-mix(in oklab, var(--muted) 90%, transparent);
  }

  .stack-icon img {
    width: 60%;
    height: 60%;
    object-fit: contain;
    filter: grayscale(1) brightness(1.9) opacity(0.7);
    transition: filter 0.3s ease;
  }

  .stack-icon:hover img {
    filter: grayscale(0) brightness(1) opacity(1);
  }
</style>
