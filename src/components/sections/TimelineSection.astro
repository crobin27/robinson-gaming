---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import { Timeline } from "@/components/timeline/Timeline";
import { milestones } from "@/data/timeline";
---

<section id="journey" class="mx-auto max-w-5xl px-6 py-20 md:py-32">
  <div data-reveal class="mb-16 text-center md:mb-24">
    <SectionHeading
      title="The journey so far"
      subtitle="How I got from my first print() to designing cloud systems for a living."
    />
  </div>

  <Timeline client:load milestones={milestones} />

  <div
    data-reveal
    data-reveal-delay="1"
    class="mt-16 flex flex-col items-center gap-3 text-center md:mt-24"
  >
    <p class="text-sm text-muted-foreground">Want the formal version?</p>
    <a
      href="/resume.pdf"
      download
      class="inline-flex h-11 items-center justify-center gap-2 rounded-md border border-primary/60 bg-primary/10 px-6 text-sm font-medium text-primary transition-colors hover:border-primary hover:bg-primary/20"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 15V3"></path>
        <path d="M6 9l6 6 6-6"></path>
        <path d="M3 21h18"></path>
      </svg>
      Download Resume
    </a>
  </div>
</section>
