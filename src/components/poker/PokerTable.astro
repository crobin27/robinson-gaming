---
import PokerTableSimulation from "./PokerTableSimulation";
---

<div class="poker-table-component">
  <PokerTableSimulation client:load />
</div>

<style>
  .poker-table-component {
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem);
    background: radial-gradient(circle at top, rgba(15, 23, 42, 0.75), rgba(2, 6, 23, 0.9));
    border-radius: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 40px 60px rgba(0, 0, 0, 0.45);
  }
</style>
