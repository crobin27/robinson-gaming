---
import "/src/styles/global.css";
import "../styles/layout.css";
import "../styles/red_felt.css"; // Red felt for About page
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutHero from "../components/AboutHero.astro";
import AboutPageComponent from "../components/AboutPageComponent.astro";
const pageTitle = "About Cole Robinson - Software Engineer & Game Developer";
const pageDescription =
  "Learn about Cole Robinson, a software engineer specializing in game development, cloud infrastructure, and embedded systems, and currently seeking employment.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <AboutHero />
  <AboutPageComponent />
</BaseLayout>

<style is:global>
  /* Override with soft velvet rose felt for About page */
  :root {
    --felt-light: #a85a6e;
    --felt-mid: #8e4a5c;
    --felt-dark: #6f3a48;
    --felt-darkest: #4a2730;
  }

  html,
  body {
    background: radial-gradient(
      ellipse 100% 80% at center,
      var(--felt-light) 0%,
      var(--felt-mid) 40%,
      var(--felt-dark) 70%,
      var(--felt-darkest) 100%
    );
    filter: saturate(1.1) brightness(1);
  }
</style>
